# ============================================================
# NN Drama — Environment Variables
# Copy to .env (web) and apps/worker/.env (worker) as needed.
# Never commit real secrets. Never hardcode keys in source.
# ============================================================

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database (Prisma / PostgreSQL) ----
# Leave empty to use the local file-backed fallback store (dev only).
DATABASE_URL=""

# ---- Persistence driver ----
# "file"  -> JSON file store under .data (dev, zero-config)
# "prisma"-> PostgreSQL via Prisma (production)
STORE_DRIVER="file"

# ---- Object storage (screenshots, generated assets) ----
# "local" -> apps/web/public/scans (dev)
# "s3"    -> S3-compatible (Cloudflare R2, AWS S3, Vercel Blob via S3)
STORAGE_DRIVER="local"
STORAGE_PUBLIC_BASE_URL=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# ---- Queue / job dispatch ----
# "inline" -> web calls the worker HTTP API directly (dev, no Redis)
# "redis"  -> BullMQ over Redis (production)
QUEUE_DRIVER="inline"
REDIS_URL=""
QUEUE_NAME="nn-drama-scan"

# ---- Browser worker (Playwright) ----
WORKER_URL="http://localhost:8787"
WORKER_SHARED_SECRET="change-me-in-production"
# Allow the worker to call back into the web app with progress/results.
INTERNAL_CALLBACK_URL="http://localhost:3000"

# ---- AI provider abstraction ----
# "none" | "openai" | "anthropic" | "gemini"
# With "none", the app uses the deterministic rule-based design-spec/prompt
# generator (no network AI calls). Add a key and set the provider to enable AI.
AI_PROVIDER="none"
AI_REQUEST_TIMEOUT_MS="60000"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# ---- Auth (Phase 4) ----
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Rate limiting / cost controls ----
RATE_LIMIT_SCANS_PER_HOUR="10"
RATE_LIMIT_CONCURRENT_SCANS="2"
MAX_PAGES_PER_SCAN="1"
MAX_SCREENSHOTS_PER_SCAN="6"
MAX_AI_REQUESTS_PER_DAY="100"
REFINE_MAX_ITERATIONS="4"
REFINE_TARGET_SIMILARITY="90"

# ---- Scanner safety limits ----
SCAN_NAVIGATION_TIMEOUT_MS="30000"
SCAN_MAX_HTML_BYTES="5242880"
SCAN_MAX_REDIRECTS="5"
SCAN_MAX_ASSETS="200"
SCAN_ALLOWED_PROTOCOLS="http:,https:"
